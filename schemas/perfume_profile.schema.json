{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scentmatch.local/schemas/perfume_profile.schema.json",
  "title": "ScentMatch perfume profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "perfume_id", "name", "brand", "source_url",
    "gender", "country", "year", "rating", "perfumers", "accords",
    "notes", "source_description", "retrieval_text"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "perfume_id": {"type": "string", "pattern": "^[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "brand": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "gender": {"type": ["string", "null"]},
    "country": {"type": ["string", "null"]},
    "year": {"type": ["integer", "null"], "minimum": 1700},
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "count"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "perfumers": {"$ref": "#/$defs/stringList"},
    "accords": {"$ref": "#/$defs/nonEmptyStringList"},
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "middle", "base"],
      "properties": {
        "top": {"$ref": "#/$defs/nonEmptyStringList"},
        "middle": {"$ref": "#/$defs/nonEmptyStringList"},
        "base": {"$ref": "#/$defs/nonEmptyStringList"}
      }
    },
    "source_description": {"type": "string"},
    "retrieval_text": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string"}},
    "nonEmptyStringList": {
      "type": "array", "minItems": 1, "items": {"type": "string"}
    }
  }
}
